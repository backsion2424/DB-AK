{
  "entities": {
    "Video": {
      "title": "Video",
      "description": "Information about a video in the library",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the video" },
        "code": { "type": "string", "description": "The unique code of the video (e.g., ABC-123)" },
        "posterUrl": { "type": "string", "description": "URL to the poster image" },
        "studio": { "type": "string", "description": "Production studio" },
        "releaseDate": { "type": "string", "format": "date", "description": "Release date" },
        "duration": { "type": "integer", "description": "Duration in minutes" },
        "actors": { "type": "array", "items": { "type": "string" }, "description": "List of actor names" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "List of tags" },
        "description": { "type": "string", "description": "Plot summary or description" },
        "rating": { "type": "number", "description": "User rating (0-5)" },
        "videoUrl": { "type": "string", "description": "Link to the video file" },
        "category": { "type": "string", "description": "Category name or ID" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string", "description": "Owner of this entry" }
      },
      "required": ["title", "code", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "User-defined categories for organizing videos",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["name", "userId"]
    },
    "Actor": {
      "title": "Actor",
      "description": "Details about a performer",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["name", "userId"]
    }
  },
  "firestore": {
    "videos": {
      "schema": "Video",
      "description": "Collection of video items"
    },
    "actors": {
      "schema": "Actor",
      "description": "Collection of actor profiles"
    },
    "categories": {
      "schema": "Category",
      "description": "Collection of user-defined categories"
    }
  }
}
