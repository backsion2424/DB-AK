{
  "name": "db-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist dist-electron release",
    "lint": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "electron:tsc": "tsc -p electron && node scripts/post-electron-build.mjs",
    "electron:dev": "concurrently -k -n vite,electron -c blue,green \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron:tsc && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && npm run electron:tsc && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^11.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dasu.db-archive",
    "productName": "DB Archive",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "DB-Archive-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DB-Archive-${version}.${ext}"
    }
  }
}
